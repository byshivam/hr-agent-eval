# Copy this file to .env and fill in your key. Never commit .env.

# Free key from https://console.groq.com
GROQ_API_KEY=

# Model that runs the HR agent (must support tool calling on Groq)
AGENT_MODEL=openai/gpt-oss-20b

# Model that grades response quality (LLM-as-a-judge). A bigger model judges better.
JUDGE_MODEL=openai/gpt-oss-120b

# System prompt version (see src/hragent/prompts.py): v3, v2 or v1_naive
PROMPT_VERSION=v3

# Max model turns per user message before the agent gives up
MAX_AGENT_STEPS=8
